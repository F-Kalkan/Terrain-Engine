<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\NativeEngine.props" />

  <PropertyGroup>
    <!-- xunit v3 test projects are executables; Avalonia's headless xUnit support needs v3. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>TerrainBench.UI.Tests</RootNamespace>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TerrainBench\TerrainBench.csproj" />
  </ItemGroup>

</Project>
